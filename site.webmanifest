---
layout: null
sitemap: false
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | truncate: 12 | jsonify }},
  "description": {{ site.description | strip_newlines | jsonify }},
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "icons": [
    {
      "src": "{{ '/assets/img/favicon.png' | relative_url }}",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "{{ '/assets/img/apple-touch-icon.png' | relative_url }}",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}